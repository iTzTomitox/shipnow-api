# Puerto del servidor
PORT=3000

# URI de MongoDB Atlas: reemplazar <usuario>, <clave> y <cluster> por los de tu cluster
# (Atlas → Connect → Drivers). La base "shipnow" se crea sola al primer insert.
MONGODB_URI=mongodb+srv://<usuario>:<clave>@<cluster>/shipnow

# Entorno: development | test | production (en production no se montan los mocks)
NODE_ENV=development

# Nivel mínimo de logs (opcional): fatal | error | warning | info | http | debug
# Por defecto: debug en development/test, info en production
LOG_LEVEL=debug